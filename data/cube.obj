# Cubo unitario centrado na origem, lado 1.0 (de -0.5 a +0.5).
# Normais apontando para FORA, winding CCW visto de fora.
# Criado por nos (dupla), para servir de base das paredes, piso e teto.
o the_cube

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# face +Z
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1
# face -Z
f 2/1/2 1/2/2 4/3/2
f 2/1/2 4/3/2 3/4/2
# face +X
f 6/1/3 2/2/3 3/3/3
f 6/1/3 3/3/3 7/4/3
# face -X
f 1/1/4 5/2/4 8/3/4
f 1/1/4 8/3/4 4/4/4
# face +Y
f 8/1/5 7/2/5 3/3/5
f 8/1/5 3/3/5 4/4/5
# face -Y
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6
